{
  "name": "process-leash",
  "version": "0.1.0",
  "description": "Run a command under wall-clock, memory, and CPU limits with process-tree cleanup and incident reports",
  "author": "Sumin Lim <lim@limsumin.com> (https://limsumin.com)",
  "type": "module",
  "bin": {
    "process-leash": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --import tsx 'test/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "process-management",
    "process-tree",
    "resource-limits",
    "timeout",
    "memory-limit",
    "cpu-limit",
    "testing",
    "cli",
    "ci",
    "linux",
    "macos"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
