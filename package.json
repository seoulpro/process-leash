{
  "name": "process-leash",
  "version": "0.1.0",
  "description": "Run a command under wall-clock, memory, and CPU limits with process-tree cleanup and incident reports",
  "author": "Sumin Lim <lim@limsumin.com> (https://limsumin.com)",
  "type": "module",
  "bin": {
    "process-leash": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --import tsx test/*.test.ts",
    "package:smoke": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run package:smoke",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "process-management",
    "process-tree",
    "resource-limits",
    "timeout",
    "memory-limit",
    "cpu-limit",
    "testing",
    "cli",
    "ci",
    "linux",
    "macos"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoulpro/process-leash.git"
  },
  "bugs": {
    "url": "https://github.com/seoulpro/process-leash/issues"
  },
  "homepage": "https://github.com/seoulpro/process-leash#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
