{
  "name": "process-leash",
  "version": "0.1.0",
  "description": "Local-first process-tree limits and incident reports for test commands",
  "type": "module",
  "bin": {
    "process-leash": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --import tsx 'test/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "process",
    "timeout",
    "memory",
    "cpu",
    "testing",
    "cli"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
